{
    "name": "croustibat/php-pty",
    "description": "node-pty for PHP. Pseudo-terminals in pure PHP — no extension to compile, no C companion library, no Node. Just FFI and pcntl. macOS and Linux.",
    "keywords": ["pty", "pseudo-terminal", "terminal", "node-pty", "ffi", "pcntl", "tty", "cli", "tui"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/croustibat/php-pty",
    "authors": [
        {
            "name": "Baptiste Bouillot",
            "email": "bbouillot@gmail.com",
            "homepage": "https://github.com/croustibat"
        }
    ],
    "support": {
        "issues": "https://github.com/croustibat/php-pty/issues",
        "source": "https://github.com/croustibat/php-pty"
    },
    "require": {
        "php": "^8.2",
        "ext-ffi": "*",
        "ext-pcntl": "*",
        "ext-posix": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Croustibat\\Pty\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Croustibat\\Pty\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
